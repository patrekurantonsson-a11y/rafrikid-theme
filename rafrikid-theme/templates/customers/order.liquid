{% comment %}templates/customers/order.liquid{% endcomment %}
<div class="rf-container" style="padding-top:2.5rem;padding-bottom:5rem;max-width:860px;">
  <nav class="rf-breadcrumbs" aria-label="Brauðmylsna">
    <a href="{{ routes.account_url }}">Reikningur</a>
    <span class="rf-breadcrumbs__sep">›</span>
    <span>{{ order.name }}</span>
  </nav>
  <h1>{{ 'customers.order.title' | t: name: order.name }}</h1>
  <p class="text-secondary">{{ order.created_at | date: '%d. %B %Y' }}</p>

  <div style="display:grid;grid-template-columns:1fr 300px;gap:2rem;align-items:start;margin-top:1.5rem;">
    <div>
      <table class="rf-list-table">
        <thead>
          <tr><th>Vara</th><th>Magn</th><th>Verð</th><th>Samtals</th></tr>
        </thead>
        <tbody>
          {%- for line in order.line_items -%}
            <tr>
              <td>
                <div style="font-weight:600;">{{ line.title | escape }}</div>
                {%- if line.variant.sku != blank -%}
                  <div class="rf-mono" style="font-size:.75rem;color:var(--rf-stal);">{{ line.variant.sku }}</div>
                {%- endif -%}
              </td>
              <td>{{ line.quantity }}</td>
              <td>{{ line.price | money }}</td>
              <td>{{ line.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <div style="background:#fff;border:1.5px solid var(--color-border);border-radius:var(--border-radius);padding:1.25rem;">
      <div class="rf-cart-totals">
        <div class="rf-cart-totals__row"><span>Millisamtals</span><span>{{ order.subtotal_price | money }}</span></div>
        {%- for discount in order.cart_level_discount_applications -%}
          <div class="rf-cart-totals__row text-success"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="rf-cart-totals__row"><span>Sending</span><span>{{ order.shipping_price | money }}</span></div>
        <div class="rf-cart-totals__row"><span>{{ 'cart.vat' | t }}</span><span>{{ order.tax_price | money }}</span></div>
        <div class="rf-cart-totals__row rf-cart-totals__row--total"><span>Samtals</span><span>{{ order.total_price | money }}</span></div>
      </div>

      <div style="margin-top:1.5rem;font-size:.875rem;">
        <div style="font-weight:700;margin-bottom:.35rem;">Afh. heimilisfang</div>
        {{ order.shipping_address | format_address }}
      </div>
    </div>
  </div>
</div>
