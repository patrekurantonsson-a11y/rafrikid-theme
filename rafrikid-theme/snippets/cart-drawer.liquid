{% comment %}
  cart-drawer.liquid — Cart drawer component rendered in theme.liquid
{% endcomment %}
<div
  id="rf-cart-drawer"
  class="rf-cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.title' | t }}"
  aria-hidden="true"
>
  <div class="rf-cart-drawer__header">
    <h2 class="rf-cart-drawer__title">{{ 'cart.title' | t }}</h2>
    <button
      class="rf-cart-drawer__close rf-icon-btn"
      data-cart-close
      aria-label="{{ 'accessibility.close' | t }}"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="rf-cart-drawer__body" id="rf-cart-drawer-body">
    {% if cart.item_count == 0 %}
      <p class="text-secondary" style="margin-top:2rem;text-align:center;">{{ 'cart.empty' | t }}</p>
    {% else %}
      {% for item in cart.items %}
        <div class="rf-cart-item" data-key="{{ item.key }}" style="display:flex;gap:.75rem;padding:.75rem 0;border-bottom:1px solid var(--color-border);">
          <img src="{{ item.image | image_url: width: 80 }}" alt="{{ item.title | escape }}" width="64" height="64" style="object-fit:contain;border:1px solid var(--color-border);border-radius:var(--border-radius);flex-shrink:0;">
          <div style="flex:1;min-width:0;">
            <div style="font-weight:600;font-size:.875rem;">{{ item.product_title | escape }}</div>
            {% unless item.variant_title == 'Default Title' %}
              <div style="font-size:.8125rem;color:var(--rf-stal);">{{ item.variant_title }}</div>
            {% endunless %}
            <div class="rf-qty" style="margin-top:.5rem;">
              <button class="rf-qty__btn" data-key="{{ item.key }}" data-delta="-1" aria-label="{{ 'accessibility.close' | t }}">−</button>
              <input class="rf-qty__input" type="number" value="{{ item.quantity }}" min="1" data-key="{{ item.key }}" aria-label="{{ 'cart.quantity' | t }}">
              <button class="rf-qty__btn" data-key="{{ item.key }}" data-delta="1" aria-label="+">+</button>
            </div>
          </div>
          <div style="text-align:right;flex-shrink:0;">
            <div style="font-weight:700;">{{ item.line_price | money }}</div>
            <button class="btn btn--secondary" style="padding:.2em .5em;font-size:.75rem;margin-top:.5rem;" data-remove="{{ item.key }}">{{ 'cart.remove' | t }}</button>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  {% if cart.item_count > 0 %}
  <div class="rf-cart-drawer__footer">
    <div class="rf-cart-totals">
      {% assign vat_amount = cart.total_price | minus: cart.total_price | divided_by: 1.24 | round %}
      <div class="rf-cart-totals__row">
        <span>{{ 'cart.vat' | t }}</span>
        <span>{{ cart.total_price | minus: cart.total_price | divided_by: 1.24 | round | money }}</span>
      </div>
      <div class="rf-cart-totals__row rf-cart-totals__row--total">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <div class="rf-cart-totals__row text-secondary" style="font-size:.8125rem;">
        <span>{{ 'cart.subtotal_excl' | t }}</span>
        <span>{{ cart.total_price | divided_by: 1.24 | round | money }}</span>
      </div>
    </div>
    <p style="font-size:.8125rem;color:var(--rf-stal);margin-bottom:.75rem;">{{ 'cart.shipping_note' | t }}</p>
    <a href="/checkout" class="btn btn--primary btn--full" style="margin-bottom:.5rem;">{{ 'cart.checkout' | t }}</a>
    <a href="/cart" class="btn btn--secondary btn--full">{{ 'cart.view_cart' | t }}</a>
  </div>
  {% endif %}
</div>
