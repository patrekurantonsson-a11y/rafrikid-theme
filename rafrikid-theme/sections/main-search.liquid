{% comment %}sections/main-search.liquid{% endcomment %}
<div class="rf-container" style="padding-top:2rem;padding-bottom:5rem;">
  <h1>{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:600px;margin-bottom:2rem;">
    <div class="rf-search-form" style="background:#fff;border-color:var(--color-border);">
      <label for="MainSearch" class="visually-hidden">{{ 'search.search' | t }}</label>
      <input type="search" id="MainSearch" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" style="color:var(--color-base-text);">
      <button type="submit" style="color:var(--rf-stal);">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>
    </div>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
    {%- else -%}
      <p style="font-size:.875rem;color:var(--rf-stal);margin-bottom:1.5rem;">
        {{ 'search.results_with_count.other' | t: count: search.results_count }}
      </p>
      <div class="rf-product-grid">
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            {% render 'product-card', product: result, lazy: true %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Leit",
  "tag": "div",
  "settings": []
}
{% endschema %}
