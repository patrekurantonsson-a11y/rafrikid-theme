{% comment %}sections/audience-panels.liquid — Tvær leiðir að versla{% endcomment %}
<section class="rf-section">
  <div class="rf-container">
    {%- if section.settings.heading != blank -%}
      <div class="rf-section__heading" style="text-align:center;margin-bottom:2rem;">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="rf-audience-panels">
      <div class="rf-audience-panel rf-audience-panel--trade">
        <svg class="rf-audience-panel__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
        <h3 class="rf-audience-panel__title">{{ section.settings.trade_title | default: 'Fyrir fagaðila' }}</h3>
        <p class="rf-audience-panel__desc">{{ section.settings.trade_desc | default: 'Nettóverð, hraðpöntun með vörunúmerum og reikningsviðskipti.' }}</p>
        <a href="{{ section.settings.trade_url | default: '/pages/fagadila-reikningur' }}" class="btn btn--dark" style="border-color:rgba(255,255,255,.3);color:#fff;">
          {{ section.settings.trade_cta | default: 'Stofna fagreikning' }}
        </a>
      </div>

      <div class="rf-audience-panel rf-audience-panel--consumer">
        <svg class="rf-audience-panel__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <h3 class="rf-audience-panel__title">{{ section.settings.consumer_title | default: 'Fyrir heimili' }}</h3>
        <p class="rf-audience-panel__desc" style="color:var(--rf-stal);">{{ section.settings.consumer_desc | default: 'Skýrar lýsingar, verð með vsk og sending heim að dyrum.' }}</p>
        <a href="{{ section.settings.consumer_url | default: '/collections/all' }}" class="btn btn--primary">
          {{ section.settings.consumer_cta | default: 'Skoða vörur' }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tvær leiðir",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Fyrirsögn", "default": "Tvær leiðir að versla" },
    { "type": "text", "id": "trade_title", "label": "Fagaðila titill", "default": "Fyrir fagaðila" },
    { "type": "textarea", "id": "trade_desc", "label": "Fagaðila lýsing", "default": "Nettóverð, hraðpöntun með vörunúmerum og reikningsviðskipti." },
    { "type": "text", "id": "trade_cta", "label": "Fagaðila hnappur", "default": "Stofna fagreikning" },
    { "type": "url", "id": "trade_url", "label": "Fagaðila hlekkur" },
    { "type": "text", "id": "consumer_title", "label": "Neytenda titill", "default": "Fyrir heimili" },
    { "type": "textarea", "id": "consumer_desc", "label": "Neytenda lýsing", "default": "Skýrar lýsingar, verð með vsk og sending heim að dyrum." },
    { "type": "text", "id": "consumer_cta", "label": "Neytenda hnappur", "default": "Skoða vörur" },
    { "type": "url", "id": "consumer_url", "label": "Neytenda hlekkur" }
  ],
  "presets": [{ "name": "Tvær leiðir" }]
}
{% endschema %}
