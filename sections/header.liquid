{% comment %}sections/header.liquid{% endcomment %}

<div class="rf-header-wrapper" role="banner">

  {%- if section.settings.announcement_text != blank -%}
    <div class="rf-announcement" role="region" aria-label="Tilkynning">
      {{ section.settings.announcement_text }}
      <button data-dismiss-announcement aria-label="{{ 'accessibility.close' | t }}" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:.75rem;font-size:1rem;">×</button>
    </div>
  {%- endif -%}

  {%- comment -%} PE stripe — top of header {%- endcomment -%}

  {%- comment -%} Utility bar {%- endcomment -%}
  <nav class="rf-utility-bar" aria-label="Hjálparvalmynd">
    <div class="rf-container rf-utility-bar__inner">
      <a href="/pages/hradpontun" style="font-weight:700;color:rgba(255,255,255,.9);">Hraðpöntun</a>
      <span aria-hidden="true" style="color:rgba(255,255,255,.2);">|</span>
      <a href="/pages/fagadila-reikningur">Fagaðilar</a>
      <a href="/pages/afhending">Sækja á staðnum</a>
      <a href="/pages/hafa-samband">Hafa samband</a>

      {%- if section.settings.phone_number != blank -%}
        <span class="rf-utility-bar__phone">&#9990; {{ section.settings.phone_number }}</span>
      {%- endif -%}

      {%- comment -%} VAT toggle {%- endcomment -%}
      <div class="rf-vat-toggle" role="group" aria-label="{{ 'vat.toggle_label' | t }}">
        <span class="rf-vat-toggle__label">{{ 'vat.toggle_label' | t }}:</span>
        <div class="rf-vat-toggle__group">
          <button
            class="rf-vat-toggle__btn{% if customer and customer.tags contains 'fagadili' %}{% else %} active{% endif %}"
            data-mode="med"
            aria-pressed="{% if customer and customer.tags contains 'fagadili' %}false{% else %}true{% endif %}"
          >{{ 'vat.with_vat' | t }}</button>
          <button
            class="rf-vat-toggle__btn{% if customer and customer.tags contains 'fagadili' %} active{% endif %}"
            data-mode="ant"
            aria-pressed="{% if customer and customer.tags contains 'fagadili' %}true{% else %}false{% endif %}"
          >{{ 'vat.without_vat' | t }}</button>
        </div>
      </div>
    </div>
  </nav>

  {%- comment -%} Main header {%- endcomment -%}
  <header class="rf-header">
    <div class="rf-container rf-header__inner">

      {%- comment -%} Logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="rf-logo" aria-label="{{ shop.name }}">
        <svg class="rf-logo__mark" width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="34" height="34" rx="8" fill="#1A5C96"/>
          <path d="M21 4L11 19h7L14 30l13-16h-7z" fill="white"/>
        </svg>
        <span class="rf-logo__wordmark">{% if section.settings.logo_text != blank %}{{ section.settings.logo_text }}{% else %}{{ shop.name }}{% endif %}</span>
      </a>

      {%- comment -%} Search {%- endcomment -%}
      <div class="rf-header__search" role="search" style="position:relative;">
        <form action="{{ routes.search_url }}" method="get" class="rf-search-form" role="search">
          <label for="HeaderSearch" class="visually-hidden">{{ 'search.search' | t }}</label>
          <input
            type="search"
            id="HeaderSearch"
            name="q"
            placeholder="{{ 'search.placeholder' | t }}"
            value="{{ search.terms | escape }}"
            aria-label="{{ 'search.search' | t }}"
            autocomplete="off"
            data-predictive-search-input
          >
          <button type="submit" aria-label="{{ 'search.search' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
        </form>
        <div id="rf-predictive-results" class="rf-predictive-results" hidden aria-label="Leitarniðurstöður"></div>
      </div>

      {%- comment -%} Icon buttons {%- endcomment -%}
      <div class="rf-header__icons">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="rf-icon-btn" aria-label="{% if customer %}{{ customer.first_name }}{% else %}Reikningur{% endif %}">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </a>
        {%- endif -%}
        <button class="rf-icon-btn" data-cart-open aria-label="{{ 'accessibility.open_cart' | t }}" style="position:relative;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span class="rf-cart-count"{% if cart.item_count == 0 %} hidden{% endif %} aria-live="polite">{{ cart.item_count }}</span>
        </button>
        <button
          class="rf-icon-btn show-mobile-only"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="rf-mobile-menu"
          aria-label="{{ 'accessibility.open_menu' | t }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  {%- comment -%} Desktop nav {%- endcomment -%}
  <nav class="rf-nav hide-mobile" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="rf-container rf-nav__inner">
      {% for link in section.settings.menu.links %}
        <div class="rf-nav__item">
          <a
            href="{{ link.url }}"
            class="rf-nav__link{% if link.active %} active{% endif %}"
            {% if link.links.size > 0 %}aria-haspopup="true" aria-expanded="false"{% endif %}
          >
            {{ link.title }}
            {%- if link.links.size > 0 -%}
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            {%- endif -%}
          </a>
          {%- if link.links.size > 0 -%}
            <div class="rf-megamenu" role="region" aria-label="{{ link.title }}">
              {% for child in link.links %}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {% endfor %}
            </div>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
  </nav>

  {%- comment -%} Mobile menu {%- endcomment -%}
  <nav id="rf-mobile-menu" class="show-mobile-only" hidden aria-label="Farsímavalmynd" style="background:var(--rf-panel);padding:1rem;">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}" style="display:block;color:rgba(255,255,255,0.85);padding:.6rem 1rem;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.08);text-decoration:none;">
        {{ link.title }}
      </a>
      {% for child in link.links %}
        <a href="{{ child.url }}" style="display:block;color:rgba(255,255,255,0.6);padding:.4rem 2rem;font-size:.875rem;text-decoration:none;">
          {{ child.title }}
        </a>
      {% endfor %}
    {% endfor %}
    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_url }}" style="display:block;color:rgba(255,255,255,0.85);padding:.6rem 1rem;font-weight:600;text-decoration:none;margin-top:.5rem;">
        {% if customer %}{{ customer.first_name }}{% else %}Innskráning{% endif %}
      </a>
    {% endif %}
  </nav>

</div>

{% schema %}
{
  "name": "Haus",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo texti",
      "default": "Rafrikid"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Valmynd",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Simi",
      "default": "422 0000"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Tilkynning",
      "default": ""
    }
  ]
}
{% endschema %}
