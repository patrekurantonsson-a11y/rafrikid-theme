{% comment %}sections/main-collection.liquid — Vöruflokkur with sidebar filters and list/grid toggle{% endcomment %}
<div class="rf-container" style="padding-top:2rem;padding-bottom:4rem;">
  <nav class="rf-breadcrumbs" aria-label="Brauðmylsna">
    <a href="/">Forsíða</a>
    <span class="rf-breadcrumbs__sep" aria-hidden="true">›</span>
    <span aria-current="page">{{ collection.title | escape }}</span>
  </nav>

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;">
    <h1 style="margin:0;font-size:clamp(1.5rem,3vw,2rem);">{{ collection.title | escape }}</h1>
    <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <button class="btn btn--secondary show-mobile-only" data-filter-open aria-expanded="false" aria-controls="rf-filter-drawer">
        {{ 'collection.filter_and_sort.filter_button' | t }}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
      </button>

      <div style="display:flex;align-items:center;gap:.75rem;">
        <div class="rf-view-toggle" role="group" aria-label="Skoðunarháttur">
          <button class="rf-view-toggle__btn active" data-view="grid" aria-label="{{ 'collection.filter_and_sort.grid_view' | t }}" aria-pressed="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          </button>
          <button class="rf-view-toggle__btn" data-view="list" aria-label="{{ 'collection.filter_and_sort.list_view' | t }}" aria-pressed="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          </button>
        </div>

        <label for="SortBy" class="visually-hidden">{{ 'collection.filter_and_sort.sort_by_label' | t }}</label>
        <select id="SortBy" class="rf-select" style="width:auto;" onchange="window.location.search = '?sort_by=' + this.value">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <option value="manual"{% if sort_by == 'manual' %} selected{% endif %}>{{ 'collection.filter_and_sort.sort_by.best_selling' | t }}</option>
          <option value="price-ascending"{% if sort_by == 'price-ascending' %} selected{% endif %}>{{ 'collection.filter_and_sort.sort_by.price_ascending' | t }}</option>
          <option value="price-descending"{% if sort_by == 'price-descending' %} selected{% endif %}>{{ 'collection.filter_and_sort.sort_by.price_descending' | t }}</option>
          <option value="created-descending"{% if sort_by == 'created-descending' %} selected{% endif %}>{{ 'collection.filter_and_sort.sort_by.created_descending' | t }}</option>
          <option value="title-ascending"{% if sort_by == 'title-ascending' %} selected{% endif %}>{{ 'collection.filter_and_sort.sort_by.title_ascending' | t }}</option>
        </select>
      </div>
    </div>
  </div>

  <div class="rf-collection-layout">
    {% comment %} Filter sidebar — desktop {% endcomment %}
    <aside class="rf-filter-sidebar hide-mobile" aria-label="{{ 'collection.filter_and_sort.filters' | t }}">
      {%- for filter in collection.filters -%}
        <div class="rf-filter-group">
          <div class="rf-filter-group__title" id="Filter{{ forloop.index }}Label">
            {{ filter.label }}
          </div>
          <div>
            {%- case filter.type -%}
              {%- when 'boolean', 'list' -%}
                {%- for value in filter.values -%}
                  <label style="display:flex;align-items:center;gap:.5rem;font-size:.875rem;cursor:pointer;padding:.2rem 0;">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      onchange="this.form ? this.form.submit() : window.location.href = '{{ value.url_to_add }}'"
                    >
                    {{ value.label }} <span style="color:var(--rf-stal);">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              {%- when 'price_range' -%}
                <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;">
                  <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}" placeholder="Min kr." class="rf-input" style="width:5.5rem;">
                  <span>–</span>
                  <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}" placeholder="Max kr." class="rf-input" style="width:5.5rem;">
                  <button class="btn btn--secondary" style="padding:.3em .7em;font-size:.8125rem;">Nota</button>
                </div>
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
      {%- if collection.filters.size > 0 -%}
        <a href="{{ collection.url }}" class="btn btn--secondary btn--full" style="font-size:.875rem;">{{ 'collection.filter_and_sort.clear_all' | t }}</a>
      {%- endif -%}
    </aside>

    {%- comment -%} Mobile filter drawer {%- endcomment -%}
    <div id="rf-filter-drawer" class="rf-cart-drawer show-mobile-only" style="width:min(320px,90vw);" role="dialog" aria-modal="true" aria-label="{{ 'collection.filter_and_sort.filters' | t }}" aria-hidden="true">
      <div class="rf-cart-drawer__header">
        <h2 class="rf-cart-drawer__title">{{ 'collection.filter_and_sort.filters' | t }}</h2>
        <button class="rf-cart-drawer__close rf-icon-btn" data-filter-close aria-label="{{ 'accessibility.close' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="rf-cart-drawer__body">
        {%- for filter in collection.filters -%}
          <div class="rf-filter-group">
            <div class="rf-filter-group__title">{{ filter.label }}</div>
            {%- for value in filter.values -%}
              <label style="display:flex;align-items:center;gap:.5rem;font-size:.875rem;cursor:pointer;padding:.25rem 0;">
                <input type="checkbox" {% if value.active %}checked{% endif %} onchange="window.location.href = '{{ value.url_to_add }}'">
                {{ value.label }} <span style="color:var(--rf-stal);">({{ value.count }})</span>
              </label>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {% comment %} Products {% endcomment %}
    <div>
      {%- paginate collection.products by section.settings.products_per_page -%}
        {% if collection.products.size == 0 %}
          <div style="text-align:center;padding:4rem 1rem;">
            <p>{{ 'collection.filter_and_sort.no_results' | t }}</p>
            <a href="{{ collection.url }}" class="btn btn--secondary">{{ 'collection.filter_and_sort.clear_all' | t }}</a>
          </div>
        {% else %}
          <p style="font-size:.8125rem;color:var(--rf-stal);margin-bottom:1rem;">
            {{ 'collection.filter_and_sort.results_count.other' | t: count: collection.products_count }}
          </p>

          {% comment %} Grid view {% endcomment %}
          <div id="rf-product-grid" class="rf-product-grid">
            {% for product in collection.products %}
              {% render 'product-card', product: product, lazy: true %}
            {% endfor %}
          </div>

          {% comment %} List/table view {% endcomment %}
          <div id="rf-product-list" hidden>
            <table class="rf-list-table" aria-label="{{ collection.title }}">
              <thead>
                <tr>
                  <th>Vara</th>
                  <th>{{ 'collection.facets.brand' | t }}</th>
                  <th class="rf-mono">MPN</th>
                  <th class="rf-mono">EAN</th>
                  <th>Staða</th>
                  <th>Magn/kassa</th>
                  <th>Verð</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {% for product in collection.products %}
                  {% assign v = product.selected_or_first_available_variant %}
                  <tr>
                    <td>
                      <a href="{{ product.url }}" style="font-weight:600;font-size:.9rem;">{{ product.title | escape }}</a>
                    </td>
                    <td style="font-size:.8125rem;color:var(--rf-stal);">{{ product.vendor }}</td>
                    <td class="rf-mono" style="font-size:.8125rem;">{{ product.metafields.custom.mpn | default: '—' }}</td>
                    <td class="rf-mono" style="font-size:.8125rem;">{{ product.metafields.custom.ean | default: '—' }}</td>
                    <td>{% render 'stock-badge', variant: v %}</td>
                    <td class="rf-mono" style="font-size:.8125rem;">{{ product.metafields.custom.kassi | default: '1' }}</td>
                    <td>{% render 'verd', product: product, variant: v %}</td>
                    <td>
                      <form action="{{ routes.cart_add_url }}" method="post" style="display:flex;gap:.25rem;align-items:center;">
                        <input type="hidden" name="id" value="{{ v.id }}">
                        <input type="number" name="quantity" value="{{ product.metafields.custom.kassi | default: 1 }}" min="1" class="rf-input" style="width:4rem;padding:.3em .5em;" aria-label="{{ 'cart.quantity' | t }}">
                        <button type="submit" class="btn btn--primary" style="padding:.4em .75em;font-size:.8125rem;">Bæta í körfu</button>
                      </form>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          {% comment %} Pagination {% endcomment %}
          {%- if paginate.pages > 1 -%}
            <nav class="rf-breadcrumbs" style="margin-top:2rem;justify-content:center;" aria-label="{{ 'pagination.label' | t }}">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}">{{ 'pagination.previous' | t }}</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  <span aria-current="page" style="font-weight:700;">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}">{{ 'pagination.next' | t }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {% endif %}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vöruflokkur",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 12, "max": 48, "step": 12, "label": "Vörur á síðu", "default": 24 }
  ]
}
{% endschema %}
