{% comment %}sections/hero-search.liquid — Search-first hero for forsíða{% endcomment %}
<section class="rf-section rf-section--dark" style="padding-block:5.5rem 4.5rem;position:relative;overflow:hidden;">
  <div class="rf-container" style="position:relative;z-index:1;">
    <h1 style="color:#fff;font-size:clamp(3.5rem,9vw,8rem);font-weight:800;letter-spacing:-0.04em;line-height:1.0;margin-bottom:1.5rem;max-width:18ch;">
      {{ section.settings.headline | default: "Raflagnaefni. Fljót afhending." }}
    </h1>
    <p style="color:rgba(255,255,255,.65);font-size:1.125rem;margin-bottom:2.5rem;line-height:1.65;max-width:52ch;font-weight:400;letter-spacing:0;">
      {{ section.settings.subheading | default: "Yfir 15.000 vörur á lager. Sendum um allt land — eða sækja á staðnum í Þorlákshöfn virka daga 8–17." }}
    </p>

    <div role="search" style="position:relative;max-width:580px;margin-bottom:2rem;">
      <form action="{{ routes.search_url }}" method="get" class="rf-search-form rf-hero-search" style="box-shadow:0 2px 16px rgba(0,0,0,0.25);">
        <label for="HeroSearch" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
        <input
          type="search"
          id="HeroSearch"
          name="q"
          placeholder="{{ section.settings.search_placeholder | default: 'Leita að vöru, vörunúmeri eða strikamerki…' }}"
          aria-label="{{ 'search.search' | t }}"
          autocomplete="off"
          style="font-size:1rem;padding:.85em 1.25em;"
        >
        <button type="submit" aria-label="{{ 'search.search' | t }}" style="padding:.85em 1.25em;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      </form>
      <div id="rf-hero-predictive-results" class="rf-predictive-results" hidden aria-label="Leitarniðurstöður"></div>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;">
      <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="btn btn--primary">{{ section.settings.cta1_text | default: 'Skoða vöruúrval' }}</a>
      <a href="{{ section.settings.cta2_url | default: routes.account_url }}" class="btn" style="background:transparent;color:rgba(255,255,255,.8);border-color:rgba(255,255,255,.25);border-radius:50px;">{{ section.settings.cta2_text | default: 'Innskráning fagaðila' }}</a>
      <span style="color:rgba(255,255,255,.25);" aria-hidden="true">·</span>
      {%- if section.settings.quick_links != blank -%}
        {% assign quick = section.settings.quick_links | split: ',' %}
        {% for ql in quick %}
          {% assign parts = ql | split: '|' %}
          <a href="{{ parts[1] | strip }}" style="color:rgba(255,255,255,.55);font-size:.875rem;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.2);padding-bottom:1px;">{{ parts[0] | strip }}</a>
        {% endfor %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Leitarhetja",
  "settings": [
    { "type": "text", "id": "headline", "label": "Fyrirsögn", "default": "Raflagnaefni. Fljót afhending." },
    { "type": "text", "id": "subheading", "label": "Undirfyrirsögn", "default": "Sendum um allt land. Sækja á staðnum í Þorlákshöfn." },
    { "type": "text", "id": "search_placeholder", "label": "Leitarstikunar placeholder", "default": "Leitaðu að vöru, vörunúmeri eða strikamerki" },
    { "type": "text", "id": "quick_links", "label": "Flýtitengar (Titill|/slod, komma-aðskilin)", "default": "Hraðpöntun|/pages/hradpontun, Ljós|/collections/ljos, Rofar|/collections/rofar" },
    { "type": "header", "content": "Takkar" },
    { "type": "text", "id": "cta1_text", "label": "Takki 1 texti", "default": "Skoða vöruúrval" },
    { "type": "url",  "id": "cta1_url",  "label": "Takki 1 hlekkur" },
    { "type": "text", "id": "cta2_text", "label": "Takki 2 texti", "default": "Innskráning fagaðila" },
    { "type": "url",  "id": "cta2_url",  "label": "Takki 2 hlekkur" }
  ],
  "presets": [{ "name": "Leitarhetja" }]
}
{% endschema %}
