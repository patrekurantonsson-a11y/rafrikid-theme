{% comment %}sections/footer.liquid{% endcomment %}
<footer class="rf-footer" role="contentinfo">
  <div class="rf-container">
    <div class="rf-footer-cols">
      <div class="rf-footer-col">
        <div class="rf-footer-col__heading">{{ 'sections.footer.categories' | t }}</div>
        {% for link in section.settings.menu_categories.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
      <div class="rf-footer-col">
        <div class="rf-footer-col__heading">{{ 'sections.footer.service' | t }}</div>
        {%- if section.settings.menu_service != blank -%}
          {% for link in section.settings.menu_service.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {%- else -%}
          <a href="/pages/afhending">Afhending</a>
          <a href="/pages/skilarettur">Skilaréttur</a>
          <a href="/pages/skilmalar">Skilmálar</a>
          <a href="/pages/personuvernd">Persónuvernd</a>
        {%- endif -%}
      </div>
      <div class="rf-footer-col">
        <div class="rf-footer-col__heading">{{ 'sections.footer.about' | t }}</div>
        {%- if section.settings.menu_about != blank -%}
          {% for link in section.settings.menu_about.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {%- else -%}
          <a href="/pages/um-okkur">Um okkur</a>
          <a href="/pages/hafa-samband">Hafa samband</a>
          <a href="/pages/fagadila-reikningur">Fagreikningur</a>
          <a href="/pages/hradpontun">Hraðpöntun</a>
        {%- endif -%}
      </div>
      <div class="rf-footer-col">
        <div class="rf-footer-col__heading">Rafríkið</div>
        <div style="color:#fff;font-size:1.4rem;font-weight:800;font-family:var(--font-display);letter-spacing:-0.03em;margin-bottom:.75rem;">Rafríkið</div>
        <p style="font-size:.875rem;line-height:1.6;">Rafmagn, ljós og lagnaefni. Þjónusta um allt land frá Þorlákshöfn.</p>
        {%- if section.settings.phone != blank -%}
          <p style="font-size:.875rem;margin-top:.75rem;"><a href="tel:{{ section.settings.phone | remove: ' ' }}" style="color:rgba(255,255,255,.85);">&#9990; {{ section.settings.phone }}</a></p>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <p style="font-size:.875rem;"><a href="mailto:{{ section.settings.email }}" style="color:rgba(255,255,255,.85);">{{ section.settings.email }}</a></p>
        {%- endif -%}
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook" style="color:rgba(255,255,255,.6);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" style="color:rgba(255,255,255,.6);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="rf-footer-bottom">
      <span>{{ section.settings.business_line | default: settings.footer_business_line }}</span>
      <span>© {{ 'now' | date: '%Y' }} Rafríkið ehf.</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Fótur",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_categories",
      "label": "Vöruflokkavalmynd",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "menu_service",
      "label": "Þjónustuvalmynd",
      "info": "Skildu eftir autt til að nota sjálfgefna tengla"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "Um okkur valmynd",
      "info": "Skildu eftir autt til að nota sjálfgefna tengla"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Sími",
      "default": "422 0000"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Netfang",
      "default": "rafrikid@rafrikid.is"
    },
    {
      "type": "text",
      "id": "business_line",
      "label": "Fyrirtækjalína",
      "default": "Rafríkið ehf. · Þorlákshöfn · kt. 000000-0000 · vsknr. 000000"
    }
  ]
}
{% endschema %}
