{% comment %}sections/main-blog.liquid{% endcomment %}
<div class="rf-container" style="padding-top:2.5rem;padding-bottom:5rem;max-width:900px;">
  <h1>{{ blog.title | escape }}</h1>
  <div class="rf-product-grid" style="grid-template-columns:repeat(3,1fr);">
    {%- for article in blog.articles -%}
      <article class="rf-card" style="overflow:hidden;">
        {%- if article.image -%}
          <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" width="600" height="400" style="width:100%;height:180px;object-fit:cover;" loading="lazy">
        {%- endif -%}
        <div style="padding:1rem;">
          <div style="font-size:.75rem;color:var(--rf-stal);margin-bottom:.5rem;">{{ article.published_at | date: '%d.%m.%Y' }}</div>
          <h2 style="font-size:1rem;margin-bottom:.5rem;"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
          <p style="font-size:.875rem;color:var(--rf-stal);">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          <a href="{{ article.url }}" style="font-size:.875rem;font-weight:600;">{{ 'blogs.article.read_more' | t }} →</a>
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Blogg",
  "tag": "div",
  "settings": []
}
{% endschema %}
